[Unit]
Description=AquaPatch FastAPI Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/christopher/aquapatch/backend
EnvironmentFile=/home/christopher/aquapatch/backend/.env
ExecStart=/home/christopher/aquapatch/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
User=christopher
Group=christopher

[Install]
WantedBy=multi-user.target
