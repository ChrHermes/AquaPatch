[Unit]
Description=AquaPatch FastAPI Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/aquapatch/backend
EnvironmentFile=/opt/aquapatch/backend/.env
ExecStart=/opt/aquapatch/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
